# ================== 数据库 ==================
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_DATABASE=lzdh
MYSQL_USER=lzdh
MYSQL_PASSWORD=CHANGE_ME
# 数据表前缀，安装后请勿修改
DB_PREFIX=lz_

# ================== 站点 ==================
# 宿主机访问端口
WEB_PORT=65002
TZ=Asia/Shanghai

# 镜像版本
APP_IMAGE=qiankong/lzdh-app:v1.0.2

# ================== 自动安装 ==================
# true : 首次启动自动建表并创建管理员（推荐）
# false: 不做任何初始化，浏览器访问站点走网页安装向导
AUTO_INSTALL=true
ADMIN_USER=admin
# 留空则随机生成，可用 `docker compose logs lzdh-app` 查看
ADMIN_PASSWORD=

# ================== 文件权限（重要）==================
# 容器内 PHP 以该 UID/GID 运行，必须与宿主机 ./data 目录属主一致，
# 否则后台无法上传头像 / 站点图标 / 附件。
# 查看当前用户: id -u && id -g
PUID=1000
PGID=1000

# 调试开关（排错时临时设为 true）
APP_DEBUG=false
